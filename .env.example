# OpsPilot Environment Configuration Example
# Copy this file to .env and adjust as necessary.

# Backend Settings
HOST=127.0.0.1
PORT=8000

# RAG / AI Agent Settings
# Options for embedding: ollama, tfidf
EMBEDDING_MODE=ollama
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434

# Observability
ENABLE_METRICS=true
